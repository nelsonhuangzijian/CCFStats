{
  "manifest_version": 3,
  "name": "CCF Statistics for Google Scholar",
  "version": "1.0.0",
  "description": "Label CCF-ranked publications on Google Scholar and count total and first-author papers using local matching and DBLP lookup.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Show CCF statistics",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://scholar.google.com/citations*",
        "https://scholar.google.com.hk/citations*",
        "https://scholar.google.com.tw/citations*",
        "https://scholar.google.com.sg/citations*",
        "https://scholar.google.com.au/citations*",
        "https://scholar.google.co.nz/citations*",
        "https://scholar.google.co.uk/citations*",
        "https://scholar.google.co.jp/citations*",
        "https://scholar.google.co.kr/citations*",
        "https://scholar.google.co.in/citations*",
        "https://scholar.google.co.id/citations*",
        "https://scholar.google.co.za/citations*",
        "https://scholar.google.de/citations*",
        "https://scholar.google.fr/citations*",
        "https://scholar.google.es/citations*",
        "https://scholar.google.it/citations*",
        "https://scholar.google.ca/citations*",
        "https://scholar.google.nl/citations*",
        "https://scholar.google.be/citations*",
        "https://scholar.google.ch/citations*",
        "https://scholar.google.at/citations*",
        "https://scholar.google.se/citations*",
        "https://scholar.google.dk/citations*",
        "https://scholar.google.no/citations*",
        "https://scholar.google.fi/citations*",
        "https://scholar.google.pt/citations*",
        "https://scholar.google.pl/citations*",
        "https://scholar.google.cz/citations*",
        "https://scholar.google.com.br/citations*",
        "https://scholar.google.com.mx/citations*",
        "https://scholar.google.com.tr/citations*",
        "https://scholar.google.co.il/citations*",
        "https://scholar.google.com.my/citations*",
        "https://scholar.google.com.vn/citations*",
        "https://scholar.google.cn/citations*"
      ],
      "js": [
        "i18n.js",
        "data/catalog.js",
        "engine.js",
        "resolver.js",
        "parsers.js",
        "placement.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://dblp.org/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
